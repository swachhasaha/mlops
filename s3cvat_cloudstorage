Configure CVAT for S3 

Edit CVAT docker-compose.override.yml

services:
  cvat_server:
    environment:
      AWS_REGION: ap-south-1
      AWS_DEFAULT_REGION: ap-south-1
	  
	  
	  
docker compose down
docker compose up -d


cvat s3 cloud storage Anonymous access (deploy cvat with eks)

aws s3 mb s3://cvat-public-storage --region ap-south-1

aws s3api put-public-access-block \
  --bucket cvat-public-storage \
  --public-access-block-configuration \
  BlockPublicAcls=false,IgnorePublicAcls=false,BlockPublicPolicy=false,RestrictPublicBuckets=false


public-policy.json

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAnonymousReadWrite",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::cvat-public-storage",
        "arn:aws:s3:::cvat-public-storage/*"
      ]
    }
  ]
}


aws s3api put-bucket-policy \
  --bucket cvat-public-storage \
  --policy file://public-policy.json


Verify Anonymous Access 
Upload anonymously:
aws s3 cp test.txt s3://cvat-public-storage/test.txt --no-sign-request

Download anonymously:
aws s3 cp s3://cvat-public-storage/test.txt ./test.txt --no-sign-request

