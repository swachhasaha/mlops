{{- $fullName := include "cvat.fullname" . -}}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ $fullName }}
  namespace: {{ .Release.Namespace }}
spec:
  entryPoints:
    - web

  routes:
    - kind: Rule
      match: PathPrefix(`/api`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    - kind: Rule
      match: PathPrefix(`/admin`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    - kind: Rule
      match: PathPrefix(`/static`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    - kind: Rule
      match: PathPrefix(`/django-rq`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    - kind: Rule
      match: PathPrefix(`/git`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    - kind: Rule
      match: PathPrefix(`/opencv`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    - kind: Rule
      match: PathPrefix(`/profiler`)
      services:
        - name: {{ $.Release.Name }}-backend-service
          port: 8080

    # Catch-all route for frontend
    - kind: Rule
      match: PathPrefix(`/`)
      services:
        - name: {{ $.Release.Name }}-frontend-service
          port: 8000

    # - kind: Rule
    #   match: PathPrefix(`/nuclio`)
    #   services:
    #     - name: {{ $.Release.Name }}-nuclio-dashboard
    #       namespace: nuclio
    #       port: 8070
    - kind: Rule
      match: PathPrefix(`/nuclio`)
      services:
        - name: nuclio-dashboard.nuclio.svc.cluster.local
          port: 8070


