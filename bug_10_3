name: Clean untagged docker image tags in ECR

on:
  workflow_dispatch:

jobs:
  clean-blank-image-tags:
    runs-on:
      group: global-scale-set-large

    env:
      AWS_DESTINATION_ACCOUNT: "042740340767"
      AWS_REGION: us-east-1
      ROLE_ARN: arn:aws:iam::042740340767:role/app-uai3062831/app-uai3062831-dhr-dbc-dev-gha-role
      AWS_DESTINATION_REPO_server: app-uai3062831-dhr-dbc-dev/cvat_backend
      AWS_DESTINATION_REPO_ui: app-uai3062831-dhr-dbc-dev/cvat_ui

    steps:

      # Assume role of gha-dev account
      - name: Assume AWS Role
        id: assume-role
        run: |
          CREDS=$(aws sts assume-role \
            --role-arn $ROLE_ARN \
            --role-session-name "ghrunner-${GITHUB_RUN_ID}" \
            --external-id ${{ secrets.APP_EXTERNAL_ID }} )
          echo "AWS_ACCESS_KEY_ID=$(echo $CREDS | jq -r .Credentials.AccessKeyId)" >> $GITHUB_OUTPUT
          echo "AWS_SECRET_ACCESS_KEY=$(echo $CREDS | jq -r .Credentials.SecretAccessKey)" >> $GITHUB_OUTPUT
          echo "AWS_SESSION_TOKEN=$(echo $CREDS | jq -r .Credentials.SessionToken)" >> $GITHUB_OUTPUT
      - name: Clean docker untagged images in DEV ECR
        env:
          AWS_ACCESS_KEY_ID: ${{ steps.assume-role.outputs.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ steps.assume-role.outputs.AWS_SECRET_ACCESS_KEY }}
          AWS_SESSION_TOKEN: ${{ steps.assume-role.outputs.AWS_SESSION_TOKEN }}
        run: |
          set -euo pipefail
          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com
          # delete untagged images_server
          untagged_ids=$(aws ecr list-images --repository-name ${AWS_DESTINATION_REPO_server} --filter tagStatus=UNTAGGED --query 'imageIds[*]' --output json)
          if [ "$untagged_ids" != "[]" ]; then
            aws ecr batch-delete-image --repository-name ${AWS_DESTINATION_REPO_server} --image-ids "$untagged_ids"
          fi
          # delete all images in ECR repo with Image tag as "-"
          image_ids=$(aws ecr list-images --repository-name ${AWS_DESTINATION_REPO_server} --query 'imageIds[?imageTag==`-`]' --output json)
          if [ "$image_ids" != "[]" ]; then
            aws ecr batch-delete-image --repository-name ${AWS_DESTINATION_REPO_server} --image-ids "$image_ids"
          fi

          # delete untagged images_ui
          untagged_ids=$(aws ecr list-images --repository-name ${AWS_DESTINATION_REPO_ui} --filter tagStatus=UNTAGGED --query 'imageIds[*]' --output json)
          if [ "$untagged_ids" != "[]" ]; then
            aws ecr batch-delete-image --repository-name ${AWS_DESTINATION_REPO_ui} --image-ids "$untagged_ids"
          fi
          # delete all images in ECR repo with Image tag as "-"
          image_ids=$(aws ecr list-images --repository-name ${AWS_DESTINATION_REPO_ui} --query 'imageIds[?imageTag==`-`]' --output json)
          if [ "$image_ids" != "[]" ]; then
            aws ecr batch-delete-image --repository-name ${AWS_DESTINATION_REPO_ui} --image-ids "$image_ids"
          fi
      
