RUN apt-get -o Acquire::ForceIPv4=true update && \
    apt-get install -y --no-install-recommends \
    bzip2 \
    ca-certificates \
    curl \
    nasm \
    git \
    build-essential \
    pkg-config \
    libgeos-c1v5 \
    libgl1 \
    libgomp1 \
    libldap-2.5-0 \
    libpython3.10 \
    libsasl2-2 \
    libxml2 \
    libxmlsec1 \
    libxmlsec1-openssl \
    nginx \
    p7zip-full \
    poppler-utils \
    python3 \
    python3-venv \
    supervisor \
    tzdata \
    unrar \
    wait-for-it \
    && rm -rf /var/lib/apt/lists/*
