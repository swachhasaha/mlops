    volumes:
      - cvat_share:/home/django/share:ro
      - cvat_data:/home/django/data
      - cvat_logs:/home/django/logs
  cvat_worker_import:
    volumes:
      - cvat_share:/home/django/share:ro
      - cvat_data:/home/django/data
  cvat_worker_export:
    volumes:
      - cvat_share:/home/django/share:ro
      - cvat_data:/home/django/data
  cvat_worker_annotation:
    volumes:
      - cvat_share:/home/django/share:ro
      - cvat_data:/home/django/data
  cvat_worker_chunks:
    volumes:
      - cvat_share:/home/django/share:ro
      - cvat_data:/home/django/data


volumes:
  cvat_share:
    driver_opts:
      type: none
      device: /mnt/share
      o: bind
  cvat_data:
    driver_opts:
      type: none
      device: /mnt/share/data   
      o: bind
  cvat_logs:
    driver_opts:
      type: none
      device: /mnt/share/logs  
