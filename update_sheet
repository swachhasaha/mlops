EC2 BASTION HOST SET UP 
   1.  curl https://raw.githubusercontent.com/helm/helm/master/scripts/get-helm-3 | bash
    2.  sudo apt-get update
    3.  sudo curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
    4 . sudo apt-get install unzip
    5.  sudo unzip awscliv2.zip
    6.  sudo ./aws/install
    7.  aws --version
    8.  curl --silent --location "https://github.com/weaveworks/eksctl/releases/latest/download/eksctl_$(uname -s)_amd64.tar.gz" | tar xz -C /tmp
    9.  sudo mv /tmp/eksctl /usr/local/bin
   10.  eksctl version
   11. curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
   12.  sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
   13.  kubectl version --client
   14.  aws configure
   15.  eksctl create cluster --name cvat-test-2025 --region ap-south-1 --version 1.34 --nodegroup-name linux-nodes --node-type t3.2xlarge --nodes 3 --node-volume-size 100
