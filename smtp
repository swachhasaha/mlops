services:
  cvat_server:
    environment:
      DJANGO_SETTINGS_MODULE: cvat.settings.production

      
      EMAIL_BACKEND: django.core.mail.backends.smtp.EmailBackend
      EMAIL_HOST: smtprelay.gevernova.net
      EMAIL_PORT: 25
      EMAIL_USE_TLS: "False"
      EMAIL_USE_SSL: "False"
      EMAIL_HOST_USER: ""
      EMAIL_HOST_PASSWORD: ""
      DEFAULT_FROM_EMAIL: "cvat@yourdomain.com"
