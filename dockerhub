        run: |
          # Tag and push as latest
          docker tag cvat/server:GEIMAGE ${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/${AWS_DESTINATION_REPO_server}:latest

          # delete previous latest
          aws ecr batch-delete-image --repository-name ${AWS_DESTINATION_REPO_server} --image-ids imageTag=latest || true

          # push new latest
