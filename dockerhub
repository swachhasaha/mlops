             echo "AWS_DESTINATION_REPO_ui=app-uai3062831-dbc-prd/cvat_ui" >> $GITHUB_ENV  
             echo "VALUES_FILE=values_prd.yaml" >> $GITHUB_ENV
             echo "SECRET_PATH=app-uai3062831/dbc/prd/db-credentials" >> $GITHUB_ENV
             echo "FETCH_DB=true" >> $GITHUB_ENV
            fi
          

      - name: Checkout code
        uses: actions/checkout@v4

      - name: Install kubectl
        run: |
          curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
          chmod +x kubectl
          sudo mv kubectl /usr/local/bin/

      - name: Assume AWS Role
        id: assume-role
        run: |
          CREDS=$(aws sts assume-role \
            --role-arn $ROLE_ARN \
            --role-session-name "ghrunner-${GITHUB_RUN_ID}" \
            --external-id ${{ secrets.APP_EXTERNAL_ID }} )

          export AWS_ACCESS_KEY_ID=$(echo $CREDS | jq -r .Credentials.AccessKeyId)
          export AWS_SECRET_ACCESS_KEY=$(echo $CREDS | jq -r .Credentials.SecretAccessKey)
          export AWS_SESSION_TOKEN=$(echo $CREDS | jq -r .Credentials.SessionToken)

          echo "AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}" >> $GITHUB_ENV
          echo "AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}" >> $GITHUB_ENV
          echo "AWS_SESSION_TOKEN=${AWS_SESSION_TOKEN}" >> $GITHUB_ENV

      - name: Debug AWS identity
        run: |
          aws sts get-caller-identity   

      - name: Docker credentials
        # if: github.ref == 'refs/heads/main'
        # env:
        #   AWS_ACCESS_KEY_ID: ${{ steps.assume-role.outputs.AWS_ACCESS_KEY_ID }}
        #   AWS_SECRET_ACCESS_KEY: ${{ steps.assume-role.outputs.AWS_SECRET_ACCESS_KEY }}
        #   AWS_SESSION_TOKEN: ${{ steps.assume-role.outputs.AWS_SESSION_TOKEN }}
        run: |
          aws ecr get-login-password --region "$AWS_REGION" \
            | docker login --username AWS --password-stdin \
              "${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"

      - name: Create new GE-Image tag
        env:
          GITHUB_TOKEN: ${{ secrets.TOKEN_FOR_REPO_PUSH }}
        run: |
          # Fetch existing tags starting with 'GE-'
          existing_tags=$(git fetch --tags && git tag -l 'GE-*')

          # Extract the version number from the latest tag
          latest_version=$(echo "$existing_tags" | sort -V | tail -1 | cut -d'-' -f2 | cut -d' ' -f1)

          # If no tags are found, set version to 1
          if [ -z "$latest_version" ]; then
            new_version=1.0
          else
            major=${latest_version%.*}
            minor=${latest_version##*.}
            if [ $minor -eq 9 ]; then
              major=$((major + 1))
              minor=0
            else
              minor=$((minor + 1))
            fi
            new_version=$major.$minor
          fi
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git config user.name "github-actions[bot]"

          # Create a new tag
          git tag -a "GE-$new_version" -m "UT-$new_version"
          git push origin "GE-$new_version"
          echo IMAGE_TAG=GE-$new_version >> $GITHUB_ENV
        shell: bash


      
      - name: Build Docker image
        if: env.SELECTED_FRAMEWORK == 'CVAT'
        # working-directory: cvat
        env: 
          DOCKER_BUILDKIT: 1
          COMPOSE_DOCKER_CLI_BUILD: 1
          HTTP_PROXY: "http://proxy.research.ge.com:80"
          HTTPS_PROXY: "http://proxy.research.ge.com:80"
          NO_PROXY: "localhost,127.0.0.1,.ge.com,.build.ge.com,github.apps.gevernova.net"
          PROXY: "http://proxy.research.ge.com:80"
        run: |
          docker compose \
            -f docker-compose.yml \
            -f docker-compose.dev.yml \
            build
          BUILT_IMAGE=$(docker images --format "table {{.Repository}}:{{.Tag}}" | grep -E "\.dkr\.ecr\." | head -1)
          echo "BUILT_IMAGE_NAME=$BUILT_IMAGE" >> $GITHUB_ENV  
  

          

     
      # -----------------------------
      # TAG SERVER IMAGE
      # -----------------------------

      - name: Tag CVAT Server Image
        if: env.SELECTED_FRAMEWORK == 'CVAT'
        run: |
          docker tag cvat/server:GEIMAGE ${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/${AWS_DESTINATION_REPO_server}:${IMAGE_TAG}
          # ECR_REGISTRY=${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com

          # docker tag cvat/server:GEIMAGE \
          #   ${ECR_REGISTRY}/${AWS_DESTINATION_REPO_server}:GEIMAGE
      

      #aqua scaning for cvat server

      - uses: actions-extra/aqua-wrappers/image-scan@master
        id: server_scan
        with:
          artifact: cvat/server:GEIMAGE
          api-key: ${{ secrets.AQUA_KEY }}
          api-secret: ${{ secrets.AQUA_SECRET }}
          registry-username: ${{ secrets.AQUA_USERNAME }}
          registry-password: ${{ secrets.AQUA_PASSWORD }}
          img-scan-token: ${{ secrets.AQUA_TOKEN }}

      - name: 'Upload Artifact'
        uses: actions/upload-artifact@v3
        with:
          name: Container-Scan-Results_server
          path: ${{ steps.server_scan.outputs.scan-result-json }}
          retention-days: 5

      - name: Aqua Docker Results
        run: |
          # result_summary=$(cat results/out.json| jq .vulnerability_summary)
          # critical=$(echo $result_summary | jq -r .critical)
          # high=$(echo $result_summary | jq -r .high)
          # critical=${critical:-0}
