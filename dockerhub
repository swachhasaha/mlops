            echo "CLUSTER_NAME=uai3062831-dbc-stg-cluster" >> $GITHUB_ENV
            echo "EFS_ID=fs-0c60eeca58eadcca5" >> $GITHUB_ENV
            echo "IAM_ROLE_S3_ARN=arn:aws:iam::743157045178:role/app-uai3062831-dbc-stage-s3-access-sa-eks" >> $GITHUB_ENV
