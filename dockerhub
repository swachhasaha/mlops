name: CVAT ultimate custom image build

on:
  workflow_dispatch:
    inputs:
      environment:
        description: Select environment
        required: true
        type: choice
        options:
          - dev
          - stage
          - prod
      modelframework:
        description: cvat upgrade set up
        required: true
        default: CVAT
        type: choice
        options:
          - CVAT

jobs:
  deploy:
    runs-on:
      group: global-scale-set-large

    env:
      AWS_REGION: us-east-1
      NAMESPACE: "cvat"
      RELEASE_NAME: "cvat-test"
      SELECTED_FRAMEWORK: ${{ github.event.inputs.modelframework }}

    steps:
      - name: Set environment variables dynamically
        run: |
          if [ "${{ github.event.inputs.environment }}" = "dev" ]; then
            echo "AWS_DESTINATION_ACCOUNT=042740340767" >> $GITHUB_ENV
            echo "CLUSTER_NAME=uai3062831-dbc-dev-cluster" >> $GITHUB_ENV
            echo "EFS_ID=fs-09afda4fc029b1a90" >> $GITHUB_ENV
            echo "IAM_ROLE_S3_ARN=arn:aws:iam::042740340767:role/app-uai3062831-dhr-dbc-dev-dev-sa-eks" >> $GITHUB_ENV
            echo "LB_ROLE_ARN=arn:aws:iam::042740340767:role/app-uai3062831-loadbalancer-controller-dev" >> $GITHUB_ENV
            echo "ROLE_ARN=arn:aws:iam::042740340767:role/app-uai3062831/app-uai3062831-dhr-dbc-dev-gha-role" >> $GITHUB_ENV
            echo "AWS_DESTINATION_REPO_server=app-uai3062831-dhr-dbc-dev/cvat_backend" >> $GITHUB_ENV
