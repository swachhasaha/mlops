          # if [ "$defects" -gt 0 ]; then
          #   echo "Exiting because the defects is greater than 0"
          #   exit 1  # You can use any non-zero exit code to indicate failure
          # fi
      - name: Aqua Results Check
        env:
          RESULTS: ${{ steps.server_scan.outputs.scan-result-json }}
        run: |
          echo success
          result_summary="$(cat ${RESULTS} | jq .vulnerability_summary)"
          echo "${result_summary}"
          critical="$(echo ${result_summary} | jq -r '.critical // 0')"
          echo "critical: ${critical}"
          high="$(echo ${result_summary} | jq -r '.high // 0')"
          echo "high: ${high}"
          echo "To view full scan results, you can view them here in Aqua: https://cloud.aquasec.com/ah/#/sc/images"
