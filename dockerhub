      # -----------------------------

      - name: Push CVAT Server Image
        if: env.SELECTED_FRAMEWORK == 'CVAT'
        run: |
          docker push ${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/${AWS_DESTINATION_REPO_server}:${IMAGE_TAG}
          # ECR_REGISTRY=${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com

          # docker push \
          #   ${ECR_REGISTRY}/${AWS_DESTINATION_REPO_server}:GEIMAGE
          
      # -----------------------------
      # PUSH SERVER LATEST IMAGE
      # -----------------------------
      - name: Push CVAT Server Image
