# Deploy Grafana using below command
kubectl create namespace grafana

helm install grafana grafana/grafana --namespace grafana --create-namespace --set persistence.enabled=true --set persistence.storageClassName=efs-sc --set service.type=ClusterIP --set adminPassword='EKS!sAWSome' --set initChownData.enabled=false --set podSecurityContext.fsGroup=472 --set securityContext.runAsUser=472 --set securityContext.runAsGroup=472 
# Check if Grafana is deployed
kubectl get all -n grafana

portforward grafana
kubectl port-forward -n grafana svc/Grafana 3000:80







