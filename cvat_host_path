5️⃣ Update CVAT values.yaml
🔹 Disable dynamic PVCs
global:
  storageClass: ""

🔹 CVAT Backend
cvat:
  backend:
    persistence:
      enabled: true
      existingClaim: cvat-data-pvc

🔹 CVAT Workers
cvat:
  worker:
    persistence:
      enabled: true
      existingClaim: cvat-data-pvc

🔹 PostgreSQL
postgresql:
  primary:
    persistence:
      enabled: true
      existingClaim: cvat-db-pvc

🔹 Redis
redis:
  master:
    persistence:
      enabled: true
      existingClaim: cvat-redis-pvc

