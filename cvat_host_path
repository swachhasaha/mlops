3️⃣ Create PersistentVolumes (PV)
📌 CVAT DATA PV
apiVersion: v1
kind: PersistentVolume
metadata:
  name: cvat-data-pv
spec:
  capacity:
    storage: 200Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: cvat-hostpath
  local:
    path: /cvat/data
  nodeAffinity:
    required:
      nodeSelectorTerms:
      - matchExpressions:
        - key: cvat-node
          operator: In
          values:
          - "true"

