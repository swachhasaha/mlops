apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: cvat-hostpath-init
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app: cvat-hostpath-init
  template:
    metadata:
      labels:
        app: cvat-hostpath-init
    spec:
      containers:
      - name: init
        image: busybox
        command:
          - sh
          - -c
          - |
            mkdir -p /host/cvat/{data,db,redis,logs,keys} && chmod -R 777 /host/cvat
        securityContext:
          privileged: true
        volumeMounts:
        - name: host
          mountPath: /host
      volumes:
      - name: host
        hostPath:
          path: /


--------------------


kubectl apply -f cvat-hostpath.yaml

sudo mkdir -p /cvat/data
sudo mkdir -p /cvat/db
sudo mkdir -p /cvat/redis
sudo mkdir -p /cvat/logs
sudo mkdir -p /cvat/keys
sudo chmod -R 777 /cvat

kubectl delete daemonset cvat-hostpath-init -n kube-system

