# This workflow builds and pushes torchrunner and tensorflow runner feature branch images to ECR
# The image is build for either the torch or tensorflow model runner based on the input provided
# The image is tagged with the feature branch entered during building of the image

name: Dev-Build Feature branch Image and Push to ECR

on:
  workflow_dispatch:
    inputs:
      modelrunner:
        description: Model runner to deploy (torch or tf)
        required: true
        default: torch
        type: choice
        options:
          - torchrunner
          - tfrunner
      feature_branch:
        description: "Feature branch for which the image needs to be built"
        required: true
        default: "main"

jobs:
  dev-build-and-push-image:
    runs-on: 
      group: old-rss-huge

    env:
      AWS_DESTINATION_ACCOUNT: "042740340767"
      AWS_REGION: us-east-1
      ROLE_ARN: arn:aws:iam::042740340767:role/app-uai3062831/app-uai3062831-dhr-dbc-dev-gha-role
      AWS_ECR: 763104351884.dkr.ecr.us-east-1.amazonaws.com
      IMAGE_NAME: ${{ github.event.inputs.modelrunner }}

    steps:
      - name: Print Input values
        run: |
          echo "IMAGE_NAME: ${IMAGE_NAME}"

      - name: Checkout code
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.inputs.feature_branch }}
          fetch-depth: 0
          lfs: true

      - name: Set build variables
        run: |
          # Set build variables based on the model runner input
          if [ "$IMAGE_NAME" = "torchrunner" ]; then
            echo "AWS_DESTINATION_REPO=app-uai3062831-dhr-dbc-dev/mmdet" >> $GITHUB_ENV
            echo "RUNTIME_SAGEMAKER_IMAGE=torch_runner-sagemaker:0.0" >> $GITHUB_ENV
            echo "MAKE_FILE_IMAGE=torch" >> $GITHUB_ENV
          elif [ "$IMAGE_NAME" = "tfrunner" ]; then
            echo "AWS_DESTINATION_REPO=app-uai3062831-dhr-dbc-dev/ai-tensorflow" >> $GITHUB_ENV
            echo "RUNTIME_SAGEMAKER_IMAGE=tf_runner-sagemaker-tf:0.0" >> $GITHUB_ENV
            echo "MAKE_FILE_IMAGE=tf" >> $GITHUB_ENV
          fi

      - name: Set IMAGE_TAG
        id: vars
        run: |
          # Get short commit SHA (from checked out branch)
          COMMIT_ID=$(git rev-parse --short HEAD)
          # Replace slashes in branch name with dashes (Docker tags cannot contain "/")
          SANITIZED_BRANCH=$(echo "${{ github.event.inputs.feature_branch }}" | tr '/' '-')
          echo "IMAGE_TAG=${SANITIZED_BRANCH}-${COMMIT_ID}" >> $GITHUB_ENV

      # Build the docker image and push to ECR
      - name: Build and Push Image to ECR
        run: |
          # Set the ECR registry
          ECR_REGISTRY=${AWS_DESTINATION_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com

          # Install build-essential
          sudo apt update && sudo apt install -y build-essential

          # Login to the AWS ECR for pulling base image
          aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${AWS_ECR}

          # Build the image
          docker build -t mmdet-training:torch2.1 -f hack/docker/Dockerfile.training .

          # Tag the image
          docker tag mmdet-training:torch2.1 ${ECR_REGISTRY}/${AWS_DESTINATION_REPO}:${IMAGE_NAME}-${IMAGE_TAG}

          # Get the credentials for the role
          CREDS=$( aws sts assume-role \
            --role-arn $ROLE_ARN \
            --role-session-name "ghrunner" \
            --external-id ${{ secrets.APP_EXTERNAL_ID }} );
          # Set the environment variables for the role
          export AWS_ACCESS_KEY_ID=$( echo "$CREDS" | jq -r .Credentials.AccessKeyId );
          export AWS_SECRET_ACCESS_KEY=$( echo "$CREDS" | jq -r .Credentials.SecretAccessKey );
          export AWS_SESSION_TOKEN=$( echo "$CREDS" | jq -r .Credentials.SessionToken );

          # Login to the ECR
          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}

          # Push the image
          docker push ${ECR_REGISTRY}/${AWS_DESTINATION_REPO}:${IMAGE_NAME}-${IMAGE_TAG}
